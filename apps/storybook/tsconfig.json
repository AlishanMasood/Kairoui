{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@kairoui/tsconfig/react-library.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "rootDir": ".",
    "types": ["node"]
  },
  "include": [".storybook/**/*.ts", ".storybook/**/*.tsx", "stories/**/*.ts", "stories/**/*.tsx"],
  "exclude": ["node_modules", "storybook-static"]
}
