# KairoUI — .npmrc
# Strict, predictable dependency management for the monorepo.

# Hoist only where explicitly needed; keep packages isolated
shamefully-hoist=false

# Require all peer dependencies to be satisfied
strict-peer-dependencies=true

# Prefer frozen lockfile in CI
prefer-frozen-lockfile=true

# Ensure packages only resolve dependencies declared in their own package.json
public-hoist-pattern[]=""
