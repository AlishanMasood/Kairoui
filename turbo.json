{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "scripts/**",
        "tsconfig.json",
        "tsconfig.build.json",
        "tsup.config.ts",
        "package.json"
      ],
      "outputs": ["dist/**"],
      "outputLogs": "new-only"
    },
    "clean": {
      "cache": false,
      "outputLogs": "new-only"
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@kairoui/storybook#build": {
      "dependsOn": ["^build"],
      "inputs": [".storybook/**", "stories/**", "package.json"],
      "outputs": ["storybook-static/**"],
      "outputLogs": "new-only"
    },
    "@kairoui/storybook#dev": {
      "cache": false,
      "persistent": true
    },
    "@kairoui/docs-site#build": {
      "dependsOn": ["^build"],
      "inputs": ["docs/**", "src/**", "docusaurus.config.ts", "sidebars.ts", "package.json"],
      "outputs": ["build/**"],
      "outputLogs": "new-only",
      "env": ["NODE_ENV"]
    },
    "@kairoui/docs-site#dev": {
      "cache": false,
      "persistent": true
    }
  }
}
