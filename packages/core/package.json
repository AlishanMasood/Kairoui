{
  "name": "@kairoui/core",
  "version": "0.0.0",
  "private": true,
  "description": "Foundation primitives, base component architecture, and core abstractions for the KairoUI platform.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./composition": {
      "types": "./dist/composition.d.ts",
      "import": "./dist/composition.js"
    },
    "./styles.css": {
      "import": "./dist/styles.css"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "dev": "tsup --watch"
  },
  "keywords": [
    "kairoui",
    "core",
    "react",
    "ui"
  ],
  "license": "SEE LICENSE IN ../../LICENSE",
  "dependencies": {
    "@kairoui/hooks": "workspace:*",
    "@kairoui/theme": "workspace:*",
    "@kairoui/utils": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  }
}
