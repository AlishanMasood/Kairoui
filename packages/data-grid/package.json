{
  "name": "@kairoui-pro/data-grid",
  "version": "0.0.0",
  "private": true,
  "description": "Enterprise DataGrid for KairoUI — column model, row model, focus, editing, and virtualization for high-density tabular workloads.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "dev": "tsup --watch"
  },
  "keywords": [
    "kairoui",
    "data-grid",
    "datagrid",
    "enterprise",
    "react"
  ],
  "license": "SEE LICENSE IN ../../LICENSE",
  "dependencies": {
    "@kairoui/core": "workspace:*",
    "@kairoui/hooks": "workspace:*",
    "@kairoui/utils": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  }
}
