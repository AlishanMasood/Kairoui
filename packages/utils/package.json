{
  "name": "@kairoui/utils",
  "version": "0.0.0",
  "private": true,
  "description": "Shared utility functions, type helpers, and common abstractions used across KairoUI packages.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "dev": "tsup --watch"
  },
  "keywords": [
    "kairoui",
    "utils",
    "utilities"
  ],
  "license": "SEE LICENSE IN ../../LICENSE"
}
