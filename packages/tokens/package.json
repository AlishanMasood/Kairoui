{
  "name": "@kairoui/tokens",
  "version": "0.0.0",
  "private": true,
  "description": "Design tokens defining color, spacing, typography, and other visual constants for the KairoUI design system.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css": {
      "import": "./dist/tokens.css"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {},
  "keywords": [
    "kairoui",
    "tokens",
    "design-tokens",
    "design-system"
  ],
